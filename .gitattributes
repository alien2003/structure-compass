# Normalize line endings; shell scripts must stay LF, Windows scripts CRLF.
* text=auto
dev text eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.jar binary
*.png binary

# Disable autocrlf on generated files, they always generate with LF
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
